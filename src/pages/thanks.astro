---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" description="Your message to JDS Guitars has been sent." noindex>
  <div class="wrap">
    <header class="page-title">
      <h1>Message sent</h1>
      <p>Jason will get back to you, usually the same day.</p>
    </header>
    <div class="prose">
      <p>If you do not hear back within two days, phone or email using the details on the <a href="/contact/">contact page</a>. Messages do occasionally go astray.</p>
      <p>Meanwhile you could look at <a href="/guitars/">the guitars in stock</a> or <a href="/repairs/">the repair price list</a>.</p>
    </div>
  </div>
</Base>
