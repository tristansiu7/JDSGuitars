---
import { BUSINESS } from '../config';
const path = Astro.url.pathname;
const nav = [
  ['/guitars/', 'Guitars'],
  ['/equipment/', 'Equipment'],
  ['/repairs/', 'Repairs'],
  ['/rentals/', 'Rentals'],
  ['/about/', 'About'],
  ['/contact/', 'Contact'],
];
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${BUSINESS.name} home`}>{BUSINESS.name}</a>
    <nav aria-label="Main">
      <ul>
        {nav.map(([href, label]) => (
          <li><a href={href} aria-current={current(href)}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--sheet);
    border-bottom: 2px solid var(--rosewood);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 0.9rem;
  }
  .brand {
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    text-transform: uppercase;
    padding: 0.1rem 0;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1.1rem;
  }
  nav a {
    display: inline-block;
    padding: 0.35rem 0;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    border-bottom-color: var(--brass);
  }
  nav a[aria-current='page'] {
    border-bottom-color: var(--rosewood);
  }
  @media (max-width: 599px) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    nav ul {
      gap: 0.1rem 0.9rem;
    }
    nav a {
      font-size: var(--fs-sm);
    }
  }
</style>
