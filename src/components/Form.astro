---
// A Netlify form with progressive enhancement. Without JavaScript it posts
// normally and lands on /thanks/. With JavaScript it posts in place and
// shows the result inline, with a plain error if something goes wrong.
import { BUSINESS } from '../config';
import { isTodo } from '../lib/format';

interface Props {
  name: string;
  submitLabel: string;
  subject: string;
}
const { name, submitLabel, subject } = Astro.props;
const fallbackEmail = isTodo(BUSINESS.email) ? null : BUSINESS.email;
const onContactPage = Astro.url.pathname === '/contact/';
---

<form class="form" name={name} method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" data-form novalidate>
  <input type="hidden" name="form-name" value={name} />
  <input type="hidden" name="subject" value={subject} />
  <p class="visually-hidden" aria-hidden="true">
    <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <slot />

  <div class="form-error" role="alert" data-error hidden></div>

  <div>
    <button type="submit" class="button" data-submit>{submitLabel}</button>
  </div>
  <p class="small muted">
    {fallbackEmail ? <Fragment>If the form fails, email <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a> instead.</Fragment> : onContactPage ? <Fragment>Phone and email are listed on this page if you would rather not use a form.</Fragment> : <Fragment>Phone and email are on the <a href="/contact/">contact page</a> if you would rather not use a form.</Fragment>}
  </p>
</form>
<div class="form-success" role="status" data-success hidden></div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const errorBox = form.querySelector<HTMLElement>('[data-error]')!;
    const successBox = form.nextElementSibling as HTMLElement | null;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select'));

    function labelFor(field: HTMLElement): string {
      const label = form.querySelector<HTMLLabelElement>(`label[for="${field.id}"]`);
      return (label?.textContent ?? field.getAttribute('name') ?? 'This field').replace(/\s*\(.*\)\s*$/, '').trim();
    }

    function problem(field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): string | null {
      if (field.name === 'bot-field') return null;
      const v = field.validity;
      if (v.valid) return null;
      const name = labelFor(field);
      if (v.valueMissing) return `${name} is needed.`;
      if (v.typeMismatch && field.getAttribute('type') === 'email') return `${name} does not look like an email address. Check for a missing @ or dot.`;
      if (v.typeMismatch && field.getAttribute('type') === 'tel') return `${name} does not look like a phone number.`;
      if (v.tooShort) return `${name} is too short.`;
      if (v.rangeUnderflow || v.rangeOverflow) return `${name} is out of range.`;
      return `${name} is not filled in correctly.`;
    }

    function showFieldError(field: HTMLElement, message: string | null) {
      const wrap = field.closest('.field') ?? field.parentElement!;
      let note = wrap.querySelector<HTMLElement>('.field-error');
      if (message) {
        if (!note) {
          note = document.createElement('p');
          note.className = 'field-error';
          note.id = `${field.id || field.getAttribute('name')}-error`;
          wrap.appendChild(note);
        }
        note.textContent = message;
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', note.id);
      } else {
        note?.remove();
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
      }
    }

    function validate(): boolean {
      let first: HTMLElement | null = null;
      const messages: string[] = [];
      fields.forEach((field) => {
        const message = problem(field);
        showFieldError(field, message);
        if (message) {
          messages.push(message);
          first = first ?? field;
        }
      });
      if (messages.length) {
        errorBox.textContent = messages.length === 1 ? messages[0] : `Please fix ${messages.length} things: ${messages.join(' ')}`;
        errorBox.hidden = false;
        (first as HTMLElement | null)?.focus();
        return false;
      }
      errorBox.hidden = true;
      return true;
    }

    fields.forEach((field) => {
      field.addEventListener('blur', () => showFieldError(field, problem(field)));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid')) showFieldError(field, problem(field));
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate()) return;
      submit.disabled = true;
      const original = submit.textContent;
      submit.textContent = 'Sending';
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!response.ok) throw new Error(`Server replied ${response.status}`);
        form.hidden = true;
        if (successBox) {
          successBox.textContent = 'Sent. Jason will get back to you, usually the same day. If you do not hear back within two days, try the phone number on the contact page.';
          successBox.hidden = false;
          successBox.focus();
        }
      } catch (err) {
        errorBox.textContent = 'The message did not send. Check your connection and try again, or use the phone number or email on the contact page.';
        errorBox.hidden = false;
        errorBox.focus();
      } finally {
        submit.disabled = false;
        submit.textContent = original;
      }
    });
  });
</script>

<style>
  .form-success,
  .form-error {
    outline: none;
  }
</style>
