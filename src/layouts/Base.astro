---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BUSINESS, SITE_URL, ANALYTICS_IN_USE } from '../config';
import { isTodo } from '../lib/format';
import { existsSync } from 'node:fs';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

// The PNG and ICO icons are generated by `npm run icons` once the mark is approved.
const iconSet = existsSync(new URL('../../public/favicon.ico', import.meta.url));

interface Props {
  title: string;
  description: string;
  // Absolute or site-relative path to the image for social previews.
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  // Extra JSON-LD objects to add to the page (e.g. Product on a detail page).
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  // A hero image to preload so it is requested before the CSS finishes parsing.
  preloadImage?: { src: string; srcset: string; sizes: string };
}

const { title, description, ogImage = '/og.png', ogType = 'website', jsonLd = [], noindex = false, preloadImage } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;
const fullTitle = title === BUSINESS.name ? `${BUSINESS.name}, Derry NH` : `${title}, ${BUSINESS.name}`;

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'MusicStore',
  '@id': `${SITE_URL}/#business`,
  name: BUSINESS.name,
  description: BUSINESS.shortDescription,
  url: SITE_URL,
  image: ogImageUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.town,
    addressRegion: BUSINESS.address.region,
    postalCode: BUSINESS.address.postcode,
    addressCountry: BUSINESS.address.country,
  },
  areaServed: BUSINESS.serviceArea,
  paymentAccepted: BUSINESS.paymentMethods.join(', '),
  founder: { '@type': 'Person', name: BUSINESS.owner },
};
if (!isTodo(BUSINESS.phone)) business.telephone = BUSINESS.phone;
if (!isTodo(BUSINESS.email)) business.email = BUSINESS.email;
if (BUSINESS.geo) business.geo = { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng };
if (BUSINESS.hoursSchema.length) business.openingHours = BUSINESS.hoursSchema;
if (BUSINESS.social.length) business.sameAs = BUSINESS.social.map((s) => s.url);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {iconSet && <link rel="icon" href="/favicon.ico" sizes="32x32" />}
    {iconSet && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#231a15" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(business)} />
    {jsonLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />)}
    {ANALYTICS_IN_USE && <meta name="analytics-in-use" content="update privacy policy" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    padding: 0.5rem 0.75rem;
    background: var(--rosewood);
    color: var(--sheet);
    border-radius: var(--radius);
    z-index: 10;
  }
  .skip:focus {
    top: 0.5rem;
  }
  main:focus {
    box-shadow: none;
  }
</style>
